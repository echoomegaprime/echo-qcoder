{
  "$version": 4,
  "context": {
    "fileName": ["AGENTS.md", "CLAUDE.md"]
  },
  "general": {
    "checkpointing": {
      "enabled": true
    }
  },
  "experimental": {
    "todoStopGuard": true,
    "agentTeam": false
  },
  "mcp": {
    "allowed": ["qcoder-serena"]
  },
  "mcpServers": {
    "qcoder-serena": {
      "command": "serena",
      "args": [
        "start-mcp-server",
        "--context",
        "codex",
        "--project-from-cwd",
        "--enable-web-dashboard",
        "false",
        "--open-web-dashboard",
        "false",
        "--tool-timeout",
        "120"
      ],
      "timeout": 120000,
      "trust": false,
      "description": "Pinned Serena semantic navigation and symbolic refactoring for the active QCoder workspace.",
      "includeTools": [
        "initial_instructions",
        "activate_project",
        "get_current_config",
        "onboarding",
        "get_symbols_overview",
        "find_symbol",
        "find_referencing_symbols",
        "find_implementations",
        "find_declaration",
        "get_diagnostics_for_file",
        "search_for_pattern",
        "replace_symbol_body",
        "insert_after_symbol",
        "insert_before_symbol",
        "rename_symbol",
        "safe_delete_symbol"
      ],
      "excludeTools": [
        "execute_shell_command",
        "read_file",
        "create_text_file",
        "replace_content",
        "replace_in_files",
        "write_memory",
        "read_memory",
        "list_memories",
        "delete_memory",
        "rename_memory",
        "edit_memory"
      ]
    }
  },
  "security": {
    "auth": {
      "selectedType": "openai"
    }
  },
  "tools": {
    "shell": {
      "enableInteractiveShell": false
    }
  },
  "model": {
    "name": "c3po-code:qcoder-64k"
  },
  "modelProviders": {
    "openai": [
      {
        "id": "c3po-code:qcoder-64k",
        "name": "FORGE local uncensored Qwen 3.6 27B (64K QCoder context)",
        "baseUrl": "http://192.168.1.220:11434/v1",
        "envKey": "QCODER_LOCAL_API_KEY",
        "generationConfig": {
          "timeout": 900000,
          "maxRetries": 1,
          "contextWindowSize": 65536,
          "samplingParams": {
            "temperature": 0.2,
            "top_p": 0.8,
            "max_tokens": 4096
          }
        }
      }
    ]
  }
}
