[Unit]
Description=Recover an expired QCoder GPU lease and restore FORGE production models
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/qcoder-gpu-lease recover-stale
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/echo-qcoder /run/lock /run/systemd/system

